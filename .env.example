# Copy to .env and edit. Values here are SAFE DEFAULTS for the bundled
# "web + pgvector" docker-compose stack. For local (non-docker) runs without a
# database, set storage/checkpointer/vector backends to sqlite (see bottom note).

# ---- LLM provider (pick one) ------------------------------------------------
# 'fake' is offline and needs no secrets — good for first boot / smoke tests.
# AGENTKIT_LLM_PROVIDER=fake
# Internal gateway provider (customer_band):
#   AGENTKIT_LLM_PROVIDER=customer_band
#   AI_CLIENT_ID=
#   AI_CLIENT_SECRET=
#   AI_APP_KEY=
# OpenAI-compatible endpoint:
AGENTKIT_LLM_PROVIDER=openai
# AGENTKIT_OPENAI_BASE_URL=http://localhost:11434/v1
AGENTKIT_OPENAI_BASE_URL=https://api.deepseek.com
# AGENTKIT_OPENAI_BASE_URL=http://host.docker.internal:11435/v1
AGENTKIT_OPENAI_API_KEY=your_openai_api_key_here
AGENTKIT_OPENAI_MODEL=deepseek-v4-flash
AGENTKIT_LLM_MAX_TOKENS=10240       # 推理模型建议 4096~8192，think 长就再调大
AGENTKIT_LLM_TIMEOUT_SECONDS=120    # 推理模型更慢，默认 30s 容易超时，顺手调大
# 关闭推理模型的 <think> 输出，更快更省、避免 JSON 被截断。
# 本开关是"统一总开关"：开启后代码会自动同时发送两种参数，覆盖不同端点——
#   chat_template_kwargs.enable_thinking=false  → vLLM / SGLang（Qwen3 等）
#   thinking.type=disabled                     → DeepSeek 官方 API（实测有效，
#                                                api.deepseek.com 会忽略前者）
# 仅对 openai provider 生效；端点两个参数都不认时无副作用（如强制推理的端点）。
AGENTKIT_OPENAI_DISABLE_THINKING=true
# 需要更细控制时，用原始 JSON 透传到请求体 extra_body（会合并到上面的开关之上）：
  AGENTKIT_OPENAI_EXTRA_BODY={"thinking": {"type": "disabled"}}            # DeepSeek
#   AGENTKIT_OPENAI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}  # vLLM/SGLang
# ---- Web console security ---------------------------------------------------
# Auth is ON by default. Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTKIT_WEB_AUTH_DISABLED=true
AGENTKIT_WEB_AUTH_TOKEN=
AGENTKIT_WEB_SECRET_KEY=
# Cookies are sent only over HTTPS when true. The compose stack serves plain
# HTTP on :8501, so this is false; set it to true once you put TLS in front.
AGENTKIT_WEB_COOKIE_SECURE=false
# Optional trusted business roles for shared-token login. Leave empty to use the
# tenant's local/demo default roles.
AGENTKIT_WEB_TOKEN_BUSINESS_ROLES=
# Production SSO: a reverse proxy can forward business roles separately from
# console RBAC roles (recommended for enterprise deployments).
AGENTKIT_AUTH_PROXY_BUSINESS_ROLES_HEADER=X-Forwarded-Business-Roles
AGENTKIT_AUTH_PROXY_DEFAULT_BUSINESS_ROLES=
# Run 360 外部日志 / Trace 跳转模板（可选）。支持占位符：
# {tenant_id} {run_id} {parent_run_id} {conversation_id} {trace_id}。
# 生产只接受 https；未配置时 Run 360 页面不显示外部链接按钮。
# AGENTKIT_LOG_URL_TEMPLATE=https://logs.example/tenant/{tenant_id}/run/{run_id}
# AGENTKIT_TRACE_URL_TEMPLATE=https://trace.example/run/{run_id}?tenant={tenant_id}

# ---- Runtime behaviour (sensible defaults) ----------------------------------
AGENTKIT_APPROVAL_CHECKPOINTER=sqlite
AGENTKIT_STORAGE_BACKEND=sqlite
AGENTKIT_DETERMINISTIC_FASTPATH=true
AGENTKIT_COMBINED_INTENT_ROUTE=true
# 最终输出治理与审计输入策略。
AGENTKIT_OUTPUT_REVIEW_ENABLED=true
AGENTKIT_OUTPUT_REVIEW_FAIL_CLOSED=true
# raw 仅用于受控调试；redacted 为默认；hash 不保存原始输入。
AGENTKIT_AUDIT_INPUT_MODE=redacted
AGENTKIT_APPROVAL_CHECKPOINTER=postgres
AGENTKIT_TOOL_MAX_WORKERS=32
# 全局自主预算是硬上限，Agent/Skill Manifest 中的局部值只能更小。
AGENTKIT_AUTONOMY_MAX_MODEL_CALLS=64
AGENTKIT_AUTONOMY_MAX_TOOL_CALLS=128
AGENTKIT_AUTONOMY_MAX_ITERATIONS=32
AGENTKIT_AUTONOMY_MAX_PLAN_STEPS=32
AGENTKIT_AUTONOMY_MAX_REPLANS=4
AGENTKIT_AUTONOMY_MAX_TOKENS=200000
AGENTKIT_AUTONOMY_TIMEOUT_SECONDS=3600
# MCP Server 的具体 command/args 在 tenants/<id>.json 的 mcp_servers 中配置。

# ---- Long-term memory vector store (PostgreSQL + pgvector) -------------------
AGENTKIT_VECTOR_STORE_BACKEND=sqlite
AGENTKIT_PG_DATABASE=agentkitdb
AGENTKIT_PG_USER=agentkit
# REQUIRED: the db service refuses to start without this. Use a strong value.
AGENTKIT_PG_PASSWORD=pass
# For docker-compose these are overridden to host=db / sslmode=disable; the
# values below apply to local (non-docker) runs against your own Postgres.
AGENTKIT_PG_HOST=host.docker.internal
AGENTKIT_PG_PORT=5432
AGENTKIT_PG_SSLMODE=require

# Running locally WITHOUT a database? Comment out the postgres block above and
# use SQLite instead (zero external dependencies):
#   AGENTKIT_VECTOR_STORE_BACKEND=sqlite

# ---- Enterprise knowledge-base RAG (Chroma) --------------------------------
# Disabled by default. Enable after ingesting docs with:
#   agentkit --tenant company_alpha rag-ingest ./knowledge --ocr
#   agentkit --tenant company_alpha rag-query "refund policy" --roles support
AGENTKIT_RAG_ENABLED=false
AGENTKIT_RAG_STORE_BACKEND=chroma
AGENTKIT_RAG_CHROMA_PATH=data/chroma
AGENTKIT_RAG_CHROMA_COLLECTION=agentkit_knowledge
AGENTKIT_RAG_TOP_K=5
AGENTKIT_RAG_CONTEXT_CAP_TOKENS=1000
AGENTKIT_RAG_CHUNK_MAX_CHARS=1200
AGENTKIT_RAG_CHUNK_OVERLAP_CHARS=120
AGENTKIT_RAG_TABLE_CHUNK_MAX_CHARS=900
AGENTKIT_RAG_OCR_CHUNK_MAX_CHARS=900
AGENTKIT_RAG_KEYWORD_WEIGHT=0.4
AGENTKIT_RAG_VECTOR_WEIGHT=0.6
AGENTKIT_RAG_MIN_VECTOR_SCORE=0.0
# none = cheapest; llm = better for terse/ambiguous user questions, costs one LLM call.
AGENTKIT_RAG_QUERY_REWRITE=none
AGENTKIT_RAG_QUERY_REWRITE_MAX=3
# none = cheapest; keyword = deterministic exact-term boost; llm = best quality but costs one LLM call.
AGENTKIT_RAG_RERANKER=none
AGENTKIT_RAG_RERANK_CANDIDATES=12
# OCR needs agentkit[rag] plus a system tesseract binary/language packs.
AGENTKIT_RAG_OCR_ENABLED=false

# ---- Shared OCR (XHS + RAG) -----------------------------------------------
# none 是全局硬关闭：不调用模型，也不隐式回退到 Tesseract；需要 OCR 时改为 ollama。
AGENTKIT_OCR_PROVIDER=none
# AGENTKIT_OCR_URL=http://host.docker.internal:11435/api/generate
AGENTKIT_OCR_URL=http://localhost:11434/api/generate
AGENTKIT_OCR_MODEL=glm-ocr:latest
AGENTKIT_OCR_TIMEOUT_SECONDS=120
AGENTKIT_OCR_MAX_IMAGE_BYTES=10485760

# ---- Browser-backed website research (Playwright) --------------------------
# Keep mock for offline development. To use live Xiaohongshu search:
#   uv sync --extra browser
#   uv run playwright install chromium
#   uv run agentkit browser-login xhs
#   AGENTKIT_XHS_RESEARCH_PROVIDER=playwright
AGENTKIT_XHS_RESEARCH_PROVIDER=playwright
# Real publication remains disabled unless explicitly set to playwright.
AGENTKIT_XHS_PUBLISHING_PROVIDER=playwright
AGENTKIT_XHS_BASE_URL=https://www.xiaohongshu.com
AGENTKIT_XHS_PUBLISH_URL=https://creator.xiaohongshu.com/publish/publish?source=official
AGENTKIT_XHS_PUBLISH_ASSET_ROOT=data/xhs-publish-assets
AGENTKIT_XHS_PUBLISH_LEDGER_PATH=data/xhs-publish-ledger.sqlite
AGENTKIT_XHS_PUBLISH_MEDIA_STRATEGY=xhs_text_image
AGENTKIT_XHS_TEXT_IMAGE_STYLE=涂鸦
AGENTKIT_XHS_TEXT_IMAGE_GENERATION_TIMEOUT_SECONDS=120
AGENTKIT_XHS_ENRICH_DETAILS=true
AGENTKIT_XHS_DETAIL_LIMIT=5
AGENTKIT_XHS_DETAIL_TIMEOUT_SECONDS=6
AGENTKIT_XHS_DETAIL_PAUSE_SECONDS=0.5
# ocr 表示 XHS 使用上面的共享 OCR；当全局 Provider 为 none 时返回 skipped 且不下载图片。
AGENTKIT_MEDIA_UNDERSTANDING_PROVIDER=ocr
AGENTKIT_MEDIA_UNDERSTANDING_MAX_IMAGES=3
AGENTKIT_MEDIA_UNDERSTANDING_MIN_CONFIDENCE=0.75
AGENTKIT_WEB_SEARCH_BROWSER=chromium
AGENTKIT_WEB_SEARCH_HEADLESS=false
AGENTKIT_WEB_SEARCH_TIMEOUT_SECONDS=30
# 仅在可见浏览器中发布结果无法确认时保留窗口供人工查看；0 表示立即关闭。
AGENTKIT_BROWSER_PUBLISH_OBSERVATION_SECONDS=90
AGENTKIT_WEB_SEARCH_MAX_SCROLLS=6
AGENTKIT_WEB_SEARCH_SCROLL_PAUSE_SECONDS=0.75
# Each site receives its own subdirectory. It contains login state and must
# never be committed or shared as a normal application artifact.
AGENTKIT_WEB_SEARCH_PROFILE_ROOT=data/browser-profiles
# Cross-platform/Docker alternative: leave PROFILE_ROOT empty and set this
# directory. Login is stored as a portable Playwright storage-state JSON file.
AGENTKIT_WEB_SEARCH_STORAGE_STATE_ROOT=
# Optional system browser overrides, normally left empty.
AGENTKIT_WEB_SEARCH_BROWSER_CHANNEL=
AGENTKIT_WEB_SEARCH_EXECUTABLE_PATH=
